{
  "expo": {
    "name": "CareCompanion",
    "slug": "carecompanion",
    "scheme": "carecompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
